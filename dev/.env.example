# Copy this file to dev/.env and replace the required OIDC values.
# dev/.env is ignored by Git. Matrix Application Service secrets are generated
# automatically under dev/secrets/ when npm run dev:up starts.

ROLLERSKATE_OIDC_DISCOVERY_URL=https://identity.example.com/.well-known/openid-configuration
ROLLERSKATE_OIDC_CLIENT_ID=rollerskate-dev
# CLI Device login uses the discovered Device Authorization Grant. Web login
# keeps Authorization Code + PKCE; set a secret only for a confidential client.
ROLLERSKATE_OIDC_CLIENT_SECRET=
ROLLERSKATE_OIDC_AUTHORIZATION_REQUEST_METHOD=get

# Published host ports. The containers communicate through their service names.
ROLLERSKATE_DEV_SERVER_PORT=4100
ROLLERSKATE_DEV_MATRIX_PORT=4200
