{
  "name": "@rollerskate/local",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "bin": {
    "rollerskate-local": "./dist/src/entrypoints/cli/main.js",
    "rollerskate-local-migrate": "./dist/src/bootstrap/migrate.js"
  },
  "scripts": {
    "prebuild": "npm --prefix ../packages/protocol run build",
    "clean": "node ../scripts/clean-dist.mjs",
    "build": "npm run build:ui && npm run build:runtime",
    "build:runtime": "npm run clean && tsc -p tsconfig.json && node scripts/copy-resources.mjs",
    "build:ui": "npm --prefix ui run build",
    "dev:ui": "npm --prefix ui run dev",
    "migrate": "node dist/src/bootstrap/migrate.js",
    "test": "node --test dist/test/*.test.js",
    "verify": "npm run build && npm test"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@rollerskate/protocol": "file:../packages/protocol"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  }
}
