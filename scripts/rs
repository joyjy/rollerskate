#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd -P)
LOCAL_ROOT="$REPO_ROOT/local"
PROTOCOL_ROOT="$REPO_ROOT/packages/protocol"
LAUNCHER="$LOCAL_ROOT/dist/src/entrypoints/cli/main.js"
PROTOCOL_ENTRY="$PROTOCOL_ROOT/dist/src/index.js"

NEEDS_BUILD=false
if [ ! -f "$LAUNCHER" ] || [ ! -f "$PROTOCOL_ENTRY" ]; then
  NEEDS_BUILD=true
elif find "$LOCAL_ROOT/src" "$LOCAL_ROOT/package.json" "$LOCAL_ROOT/tsconfig.json" \
  -newer "$LAUNCHER" -print -quit | grep -q .; then
  NEEDS_BUILD=true
elif find "$PROTOCOL_ROOT/src" "$PROTOCOL_ROOT/package.json" "$PROTOCOL_ROOT/tsconfig.json" \
  -newer "$PROTOCOL_ENTRY" -print -quit | grep -q .; then
  NEEDS_BUILD=true
fi

if [ "$NEEDS_BUILD" = true ]; then
  npm --prefix "$PROTOCOL_ROOT" run --silent build
  npm --prefix "$LOCAL_ROOT" run --silent build:runtime
fi

ROLLERSKATE_REPO_ROOT="$REPO_ROOT" exec node \
  --disable-warning=ExperimentalWarning "$LAUNCHER" "$@"
